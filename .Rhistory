#filter data
data_lo<- data %>% filter(data$longitudinal =="yes" & data$timepoint == "B")
data_nolo<- data %>% filter(data$longitudinal =="no")
data_oneeach<- rbind(data_lo, data_nolo)
# Convert weeks + days into decimal weeks
data$gestational_age_delivery_final <- data$gestation_at_delivery + data$gestation_at_delivery_days / 7
# Check
head(data[, c("gestation_at_delivery", "gestation_at_delivery_days", "gestational_age_delivery_final")])
# Progesterone
model_prog_gad <- lm(progesterone_ng_g ~ gestational_age_delivery_final, data = data)
summary(model_prog_gad)
# Cortisol
model_cort_gad <- lm(cortisol_ng_g ~ gestational_age_delivery_final, data = data)
summary(model_cort_gad)
# Androstenedione
model_and_gad <- lm(androstenedione_ng_g ~ gestational_age_delivery_final, data = data)
summary(model_and_gad)
# Function to extract R², F-statistic, p-value
get_stats <- function(model){
s <- summary(model)
R2 <- round(s$r.squared, 3)
Fstat <- round(s$fstatistic[1], 3)
df1 <- s$fstatistic[2]
df2 <- s$fstatistic[3]
pval <- signif(pf(Fstat, df1, df2, lower.tail = FALSE), 3)
return(list(R2 = R2, Fstat = Fstat, df1 = df1, df2 = df2, pval = pval))
}
stats_prog <- get_stats(model_prog_gad)
stats_cort <- get_stats(model_cort_gad)
stats_and <- get_stats(model_and_gad)
# Convert risk_group to numeric 0/1
data_clean$risk_bin <- ifelse(data_clean$risk_group == "high", 1, 0)
# Run logistic regression
model_multi <- glm(risk_bin ~ progesterone_ng_g + cortisol_ng_g + androstenedione_ng_g,
data = data_clean, family = binomial)
summary(model_multi)
#adjust for maternal confunders
model_multi_cov <- glm(risk_bin ~ progesterone_ng_g + cortisol_ng_g + androstenedione_ng_g +
age + bmi + parity, data = data_clean, family = binomial)
summary(model_multi_cov)
# Load packages
library(caret)
library(glmnet)
library(pROC)
library(dplyr)
# Prepare modeling dataset
data_model <- data_clean %>%
select(risk_group,
progesterone_ng_g,
cortisol_ng_g,
androstenedione_ng_g,
age, bmi, parity) %>%
na.omit()
# Ensure outcome is a factor with correct ordering
data_model$risk_group <- factor(
data_model$risk_group,
levels = c("control", "high")
)
# Set seed for reproducibility
set.seed(123)
# Define 3-fold cross-validation
ctrl <- trainControl(
method = "cv",
number = 3,
classProbs = TRUE,
summaryFunction = twoClassSummary,
savePredictions = TRUE
)
# Train logistic regression via caret (glmnet with no regularization)
model_cv <- train(
risk_group ~ progesterone_ng_g +
cortisol_ng_g +
androstenedione_ng_g +
age + bmi + parity,
data = data_model,
method = "glmnet",
metric = "ROC",
trControl = ctrl,
tuneGrid = expand.grid(
alpha = 0,
lambda = 0
),
family = "binomial"
)
# Extract cross-validated ROC AUC
cv_auc <- max(model_cv$results$ROC)
print(paste("3-fold cross-validated ROC AUC:", round(cv_auc, 3)))
# Plot ROC curve
roc_obj <- roc(
response = model_cv$pred$obs,
predictor = model_cv$pred$high
)
plot(
roc_obj,
main = paste("Cross-validated ROC AUC =", round(cv_auc, 3)),
lwd = 3
)
png(here("images_reviewed", "cross_validated_ROC.png"),
width = 6, height = 6, units = "in", res = 300)
plot(
roc_obj,
main = paste("Cross-validated ROC AUC =", round(cv_auc, 3)),
lwd = 3
)
dev.off()
plot
plot(
roc_obj,
main = paste("Cross-validated ROC AUC =", round(cv_auc, 3)),
lwd = 3
)
